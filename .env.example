# API key from UniFi Network > Settings > Control Plane > Integrations.
UNIFI_API_KEY=

# Set exactly one of these three.
# Local console: its IP address or hostname.
UNIFI_HOST=192.168.1.1
# Cloud connector: the console ID from unifi.ui.com.
# UNIFI_CONSOLE_ID=
# Any other URL that ends in /proxy/network/integration.
# UNIFI_BASE_URL=

# Local consoles usually use a self-signed certificate. Set this to false only on a network that you trust.
UNIFI_VERIFY_TLS=true
UNIFI_TIMEOUT=30
# Optional. If you omit it and the console has exactly one site, the server uses that site.
# UNIFI_DEFAULT_SITE_ID=
